{
  "version": 1,
  "comment": "L3 危险域规则包（v0.3 Config 化）。用户可改本文件定制红线：加域/删域/改正则。结构无效或列表为空时引擎回退内置默认规则（fail-closed：防护不静默解除）。noExemptDomains 中的域命中即拦、不查豁免。flags 传 RegExp flags（推荐 i）。",
  "l3Domains": [
    {
      "domain": "编码执行",
      "pattern": "-EncodedCommand\\b",
      "flags": "i",
      "noExempt": true
    },
    {
      "domain": "解码执行",
      "pattern": "(?:\\bbase64\\b[^;&\\n]*(?:-d|--decode)[^;&\\n]*\\|\\s*(?:sh|bash|zsh)\\b|\\bFromBase64String\\b[^;&\\n]*\\b(?:Invoke-Expression|IEX)\\b)",
      "flags": "i",
      "noExempt": true
    },
    {
      "domain": "数据删除",
      "pattern": "\\bhelm\\s+uninstall\\b|\\bdocker\\s+container\\s+prune\\b|\\bjournalctl\\b[^;&|\\n]*--vacuum",
      "flags": "i"
    },
    {
      "domain": "数据删除",
      "pattern": "(?<![-\\w])rm\\s+\\S|\\bRemove-Item\\b|\\bClear-Content\\b|(?:^|[;&|]\\s*|\\n\\s*)(?:del|erase|rd|rmdir|ri)(?:\\s+\\S|\\s*(?:$|[;&|]))|\\b(?:cmd|cmd\\.exe|powershell|pwsh)\\b[^;&|\\n]{0,80}\\b(?:del|erase|rd|rmdir)\\b|git\\s+(?:reset\\s+--hard|clean\\b|stash\\s+clear\\b|checkout\\s+--|stash\\s+(?:drop|clear))|\\bshred\\b|\\bunlink\\b|\\bdocker\\s+(?:rmi\\b|volume\\s+rm\\b|image\\s+prune\\b|system\\s+prune\\b)|\\b(?:node|python|python3)\\s+(?:-\\S+\\s+){0,3}[\"'].*\\b(?:unlinkSync|rmSync|rmtree|os\\.remove)\\b|sed\\s+-i[^;&|\\n]*\\d+d\\b|\\bfind\\s[^;&|\\n]*-delete\\b|\\btruncate\\s+-s\\s|\\bmv\\s[^;&|\\n]*\\/dev\\/null\\b|\\bkubectl\\s+delete\\b",
      "flags": "i"
    },
    {
      "domain": "远端执行",
      "pattern": "\\b(?:curl|wget)\\b[^;&|]*(?:\\|\\s*(?:sh|bash|zsh|powershell)\\b|\\|\\s*\\.\\s)",
      "flags": "i"
    },
    {
      "domain": "敏感路径写",
      "pattern": "(?:>>?|\\bSet-Content\\b|\\bOut-File\\b|\\bAdd-Content\\b)[^;&|\\n]*[\\/\\\\]\\.(?:ssh|aws|gnupg)[\\/\\\\]|(?:>>?|\\bSet-Content\\b|\\bOut-File\\b|\\bAdd-Content\\b)[^;&|\\n]*(?:authorized_keys|\\.bashrc|\\.profile\\b|\\.npmrc|\\.netrc)",
      "flags": "i"
    },
    {
      "domain": "远端写/发布",
      "pattern": "\\bgit\\s+push[^;&|]*(?:--force|-f\\s|--force-with-lease|--delete\\b|--tags?\\b)|\\b(?:npm|pnpm|yarn)\\s+(?:publish|unpublish)\\b|\\bgh\\s+release\\s+(?:create|delete)\\b|\\bdocker\\s+push\\b",
      "flags": "i"
    },
    {
      "domain": "生产配置写",
      "pattern": "(?:^|[\\s\"'|;&])/etc/|\\breg\\s+add\\b|\\bschtasks\\s+/create\\b|\\bcrontab\\b|\\bnetsh\\b",
      "flags": "i"
    },
    {
      "domain": "权限变更",
      "pattern": "\\bchmod\\s+(?:-R\\s+)?0{3}\\b|\\bchmod\\s+777\\b|\\bchown\\b|\\busermod\\b|\\buseradd\\b|\\bnet\\s+user\\b|\\bicacls\\b|\\bcacls\\b|\\btakeown\\b|\\bSet-Acl\\b",
      "flags": "i"
    },
    {
      "domain": "系统迁移/覆盖",
      "pattern": "\\bmkfs\\b|\\bdd\\s+if=|\\bformat\\b\\s|\\bdiskpart\\b",
      "flags": "i"
    },
    {
      "domain": "破坏性远端操作",
      "pattern": "\\bcurl\\b[^;&|\\n]*-X\\s*(?:DELETE|PUT)\\b|\\bwget\\b[^;&|\\n]*--method=(?:DELETE|PUT)\\b",
      "flags": "i"
    }
  ],
  "readonlyExempts": [
    {
      "pattern": "(?:^|[;&|]\\s*)(?:cat|ls|dir|head|tail|stat|file|less|more|grep)\\s[^;&|]*/etc/",
      "flags": "i"
    },
    {
      "pattern": "\\bcrontab\\s+-l\\b",
      "flags": "i"
    },
    {
      "pattern": "\\bnetsh\\b[^;&|]*\\b(?:show|dump|list)\\b",
      "flags": "i"
    },
    {
      "pattern": "\\bicacls\\b(?![^;&|]*/(?:grant|deny|remove|reset|setowner|inheritance))",
      "flags": "i"
    },
    {
      "pattern": "\\b(?:Get-Help|help|man|Get-Command)\\b[^;&|]*\\b(?:rm|del|Remove-Item|erase)\\b",
      "flags": "i"
    },
    {
      "pattern": "\\btakeown\\s+/\\?",
      "flags": "i"
    },
    {
      "pattern": "git\\s+clean\\b[^\\n;&|]*?(?:^|\\s)-n(?:\\s|$)",
      "flags": "i"
    },
    {
      "pattern": "^\\s*(?:echo|Write-Output|Write-Host|printf)\\s(?![^;&|]*>>?)[^;&|]*$",
      "flags": "i"
    }
  ]
}
