{
  "name": "shisan-xinuo-dsh-plugin",
  "version": "0.1.0-mvp",
  "description": "DeepSeek Harness 运行时治理插件：L3 拦截＋真值收口＋规则 Config 化＋提示词管理后台（0.1 MVP）",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "runtime-governance",
    "agent-workflow",
    "engineering-discipline",
    "closeout-verification",
    "l3-guard"
  ],
  "author": "十三希诺 <a13sino@qq.com>",
  "homepage": "https://github.com/zxc663/shisan-xinuo-dsh-plugin#readme",
  "bugs": {
    "url": "https://github.com/zxc663/shisan-xinuo-dsh-plugin/issues"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxc663/shisan-xinuo-dsh-plugin.git"
  },
  "exports": {
    ".": "./lib/shisan-xinuo-core.js",
    "./lib/*": "./lib/*",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "lib",
    "client.js",
    "content",
    "scripts/workspace-index.mjs",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/run-all-tests.mjs",
    "tally:report": "node scripts/tally.mjs --report --freeze",
    "tally:check": "node scripts/tally.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@types/node": "^22.20.5",
    "typescript": "5.7"
  }
}
