{
  "name": "shisan-xinuo-dsh-plugin",
  "version": "1.0.0-rc.1",
  "description": "DeepSeek Harness 运行时治理插件：L3 拦截+真值收口+规则 Config 化（工程验收版）",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zxc663/shisan-xinuo-dsh-plugin.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "lib",
    "content",
    "scripts/workspace-index.mjs",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/run-all-tests.mjs",
    "tally:report": "node scripts/tally.mjs --report --freeze",
    "tally:check": "node scripts/tally.mjs --check"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1",
    "@types/node": "^22.20.5",
    "typescript": "5.7"
  }
}
